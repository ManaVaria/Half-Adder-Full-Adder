Design/Source Code(Half Adder):
module Halfadder(
    input a,
    input b,
    output sum,
    output carry
    );
    assign sum=a^b ;
    assign carry=a&b ;
endmodule

Design/Source Code(Full Adder):
module full_adder(
input a,b,cin,
output sum,carry
    );
    
    wire s1,c1,c2;
    Halfadder HA1(a,b,s1,c1);
    Halfadder HA2(s1,cin,sum,c2);
    assign carry=c1|c2;
endmodule

